# =====================================================================
# Admin dashboard (admin/). Copy to admin/.env.local.
# NEXT_PUBLIC_* values are baked in at build time and visible in the browser.
# =====================================================================

# ---------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://api.localhost/api
NEXT_PUBLIC_APP_URL=http://admin.localhost
# Extra hosts served as the platform dashboard (comma-separated, optional).
NEXT_PUBLIC_PLATFORM_HOSTS=

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development
# Server-side API URL, bypasses nginx. Dev: http://localhost:5001/api. Prod: http://api:5000/api
INTERNAL_API_URL=http://localhost:5001/api
