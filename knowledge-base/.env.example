# Qdrant connection
QDRANT_HOST=localhost
QDRANT_PORT=6333
# A new prefix keeps Voyage's 1024-dimensional index separate from the old BGE index.
QDRANT_COLLECTION_PREFIX=kb_voyage_context_4

# Unstructured Transform parses PDF and DOCX. Markdown and TXT remain local.
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
UNSTRUCTURED_TIMEOUT_SECONDS=300
UNSTRUCTURED_POLL_INTERVAL_SECONDS=5

# Voyage Context 4 creates dense vectors. All chunks from one document are
# submitted together so every chunk embedding carries document-level context.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-context-4
VOYAGE_EMBEDDING_DIMENSION=1024
VOYAGE_TIMEOUT_SECONDS=120
VOYAGE_REQUEST_MAX_CHARS=200000

# Local sparse/BM25 vectors used for hybrid retrieval.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
FASTEMBED_CACHE_PATH=/models

# Retrieval tuning
KB_MIN_SCORE=0.35
KB_HYBRID_CANDIDATES=100

# Ingestion limits
KB_MAX_FILE_SIZE=5242880
KB_MAX_CHUNKS_PER_DOCUMENT=250
KB_CHUNK_SIZE_CHARS=2400
