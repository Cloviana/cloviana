{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "manualRestart": false,
    "assets": [
      { "include": "**/*.prompt.hbs" },
      { "include": "**/*.hbs" }
    ],
    "watchAssets": true
  },
  "generateOptions": {
    "spec": false
  }
}
