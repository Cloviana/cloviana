{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": true,
    "manualRestart": false,
    "assets": [{ "include": "**/*.hbs" }, { "include": "**/*.md" }],
    "watchAssets": true
  },
  "generateOptions": {
    "spec": false
  }
}
