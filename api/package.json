{
  "name": "template-api",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build --type-check",
    "format": "biome format --write . && prisma format",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker.js",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "lint": "biome check . --fix",
    "lint:ci": "biome check .",
    "test": "node --import tsx --test $(find src -name '*.test.ts' -print)",
    "test:audit": "tsx scripts/run-audit.ts",
    "test:crawlability": "tsx scripts/run-crawlability-checks.ts",
    "test:prompt-generation": "node --import tsx scripts/run-prompt-generation.ts",
    "test:monitoring": "tsx scripts/run-monitoring.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force"
  },
  "dependencies": {
