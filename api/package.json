{
  "name": "cloviana-api",
  "version": "0.0.1",
  "description": "Cloviana marketplace API.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "^22.12 || >=24.0"
  },
  "scripts": {
    "build": "nest build --type-check",
    "format": "biome format --write . && prisma format",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "lint": "biome check . --fix",
    "lint:ci": "biome check .",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@daytona/sdk": "^0.230.0",
    "@itgorillaz/configify": "4.0.1",
    "@keyv/redis": "5.1.3",
    "@langchain/core": "^1.3.4",
    "@langchain/daytona": "^0.2.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openrouter": "^0.4.21",
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@opencode-ai/sdk": "1.19.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.2",
    "cloudflare": "^7.3.0",
    "deepagents": "^1.16.2",
    "dotenv": "17.2.1",
    "exa-js": "^2.11.0",
    "fastify": "5.5.0",
    "file-type": "22.3.0",
    "inngest": "4.2.6",
    "keyv": "5.5.3",
    "langchain": "^1.6.1",
    "p-limit": "7.1.0",
    "p-retry": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.9.4",
    "rxjs": "^7.8.2",
    "tar-stream": "^3.2.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.4",
    "@types/node": "^22.17.2",
    "@types/tar-stream": "^3.1.5",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "prisma"
    ],
    "overrides": {
      "fastify": "5.5.0"
    }
  }
}
