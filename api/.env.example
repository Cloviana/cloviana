# =====================================================================
# Cloviana API (api/). Copy to api/.env.
# Required = the API refuses to boot without it. Optional = feature is off when empty.
# =====================================================================

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
API_PORT=5001
API_HOST=0.0.0.0
ENVIRONMENT=development

# ---------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------
# Admin dashboard origin (CORS allow-list).
APP_URL=http://admin.localhost
# Public URL of this API, including /api.
API_URL=http://api.localhost/api

# ---------------------------------------------------------------------
# Database (Neon Postgres 18).
# DATABASE_URL: pooled host (contains -pooler), used by the app.
# DIRECT_URL: same host without -pooler, used by Prisma migrations.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------
# Platform realm: owners and staff (Better Auth)
# ---------------------------------------------------------------------
# REQUIRED, 32+ characters. Generate: openssl rand -base64 48
# Google callback: <APP_URL>/api/platform-auth/callback/google (shares GOOGLE_CLIENT_* below).
PLATFORM_AUTH_SECRET=

# ---------------------------------------------------------------------
# Marketplace realm: vendors and shoppers (Better Auth)
# ---------------------------------------------------------------------
# Stores live at <slug>.PLATFORM_BASE_DOMAIN. Dev: <slug>.localhost.
PLATFORM_BASE_DOMAIN=localhost
# Public origin of this API (shared OAuth callbacks, protocol/port of invite links).
# Dev goes through nginx so invite links get port 80: http://api.localhost
MARKETPLACE_AUTH_URL=http://api.localhost
# REQUIRED, 32+ characters. Generate: openssl rand -base64 48
MARKETPLACE_AUTH_SECRET=
# Sender of invite and verification emails (needs RESEND_API_KEY to actually send).
MARKETPLACE_AUTH_EMAIL_FROM=Cloviana <no-reply@cloviana.com>
# Optional Google sign-in. Register <MARKETPLACE_AUTH_URL>/api/marketplace-auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Infrastructure (docker: `docker compose -f docker/compose-core.yaml -f docker/compose-dev.yaml up -d`)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
INNGEST_DEV=http://localhost:8288
INNGEST_BASE_URL=http://localhost:8288
INNGEST_CONNECT_GATEWAY_URL=ws://localhost:8289/v0/connect
INNGEST_EVENT_KEY=0123456789abcdef0123456789abcdef
INNGEST_SIGNING_KEY=abcdef0123456789abcdef0123456789
INNGEST_MAX_WORKER_CONCURRENCY=12

# ---------------------------------------------------------------------
# Optional providers
# ---------------------------------------------------------------------
# Email (invites are only logged in dev when empty, dropped in production)
RESEND_API_KEY=
# AI + research
OPENROUTER_API_KEY=
EXA_API_KEY=

# Assistant: Deep Agents coordinates; OpenCode edits in an isolated sandbox.
AGENT_MODEL=anthropic/claude-sonnet-4.6
CODING_AGENT_MODEL=anthropic/claude-sonnet-4.6
AGENT_WORKER_CONCURRENCY=2
# Development uses local Docker containers. Production uses Daytona.
SANDBOX_PROVIDER=docker
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=eu
# Optional prebuilt image with Node 22+, Python 3, Git, curl and opencode-ai@1.19.5.
DAYTONA_SNAPSHOT=
# Public HTTPS API base (including /api) for Daytona -> model proxy calls.
# Local Docker uses host.docker.internal:API_PORT/api and does not need a tunnel.
AGENT_MODEL_PROXY_URL=

# Cloudflare R2 product media (R2_PUBLIC_BASE_URL = public bucket domain)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Private bucket (no public access) for theme code snapshots and starter templates
R2_PRIVATE_BUCKET=
