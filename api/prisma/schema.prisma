generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum StoreStatus {
  DRAFT
  ACTIVE
  LOCKED
  INITIALIZING
  FAILED
}

enum Platform {
  SHOPIFY
  WOOCOMMERCE
  BIGCOMMERCE
  CUSTOM
}

enum NodeType {
  PARAGRAPH
  HEADING
  LIST
  LIST_ITEM
  CODE_BLOCK
  QUOTE
  IMAGE
  LINK
  TEXT
  LINEBREAK
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogSetupStep {
  TOPIC
  PRIMARY_KEYWORD
  SECONDARY_KEYWORDS
  PRODUCT
  AUDIENCE_INTENT
  GUIDELINES
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum JobType {
  PRODUCT_SYNC
  CATALOG_SYNC
  BLOG_GENERATION
  SITEMAP_BUILD
  KEYWORD_DISCOVERY
  STORE_METADATA
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum PlanName {
  STARTER
  PRO
  GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALLING
}

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum WordCountPreset {
  SHORT
  MEDIUM
  LONG
}

// --- BILLING MODELS ---

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  name          PlanName
  stripePriceId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  status SubscriptionStatus @default(ACTIVE)

  stripeSubscriptionId String? @unique

  trialEndsAt DateTime?
  storeId     String    @unique

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id]) // No Cascade here (don't delete subs if plan deleted)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- CORE MODELS ---

model Store {
  id               String      @id @default(cuid())
  ownerId          String      @db.Uuid
  stripeCustomerId String?
  name             String
  domainUrl        String
  profileUrl       String?
  description      String?
  status           StoreStatus @default(LOCKED)

  platform Platform @default(SHOPIFY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?

  owner       Profile      @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blogs       Blog[]
  jobs        Job[]
  products    Product[]
  collections Collection[]
  channel     Channel?

  @@index([ownerId])
  @@map("stores")
}

model Channel {
  id String @id @default(uuid()) @db.Uuid

  shop String @unique @db.Citext

  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("channels")
}

model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  contactEmail String?  @db.Citext
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storesOwned Store[] @relation("StoreOwner")

  @@map("profiles")
}

model Product {
  id      String @id @default(uuid()) @db.Uuid
  storeId String

  externalId String

  title       String
  slug        String?       @db.Citext
  status      ProductStatus
  description String?

  collections Collection[]

  imageUrl String?

  url String?

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogs Blog[]

  @@unique([storeId, externalId])
  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("products")
}

model Collection {
  id      String @id @default(uuid()) @db.Uuid
  storeId String

  externalId String

  title       String
  slug        String? @db.Citext
  description String?
  imageUrl    String?

  url String?

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]
  blogs    Blog[]

  @@unique([storeId, externalId])
  @@unique([storeId, slug])
  @@map("collections")
}

// --- CONTENT MODELS ---

model Blog {
  id                    String        @id @default(uuid()) @db.Uuid
  topic                 String?
  title                 String?
  slug                  String?
  description           String?
  targetPersona         String?
  brandVoice         String?
  searchIntent          SearchIntent?
  wordCount             WordCountPreset?
  primaryKeyword        String?
  secondaryKeywords     String[]      @default([])
  additionalInstruction String?
  status                BlogStatus    @default(DRAFT)
  currentStep           BlogSetupStep @default(PRODUCT)
  storeId               String

  externalId String?

  jobId     String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  job   Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull) 
  products    Product[]
  collections Collection[]
  nodes       Node[]
  thumbnail   Thumbnail?

  @@index([storeId])
  @@map("blogs")
}

model Node {
  blogId    String   @db.Uuid
  key       String   @default(cuid())
  parentKey String?
  type      NodeType
  sortOrder Int
  payload   Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent   Node?  @relation("NodeChildren", fields: [blogId, parentKey], references: [blogId, key], onDelete: Cascade)
  children Node[] @relation("NodeChildren")

  @@id([blogId, key])
  @@index([blogId, parentKey, sortOrder])
  @@map("nodes")
}

model Thumbnail {
  id       String @id @default(uuid()) @db.Uuid
  blogId   String @unique @db.Uuid
  altText  String
  blobPath String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  storeId         String?
  status          JobStatus @default(PENDING)
  priority        Int       @default(0)
  attempts        Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  payload         Json?     @db.JsonB
  result          Json?     @db.JsonB
  error           String?
  dedupeKey       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogs Blog[]

  @@unique([type, storeId, dedupeKey])
  @@index([type, status, priority, scheduledAt])
  @@index([storeId, type, status])
  @@map("jobs")
}