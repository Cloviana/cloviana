generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoreStatus {
  DRAFT
  ACTIVE
  LOCKED
  INITIALIZING
  FAILED
}

enum NodeType {
  PARAGRAPH
  HEADING
  LIST
  LIST_ITEM
  CODE_BLOCK
  QUOTE
  IMAGE
  LINK
  TEXT
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogSetupStep {
  TOPIC
  PRIMARY_KEYWORD
  TITLE
  SECONDARY_KEYWORDS
  PRODUCT
  ENHANCEMENTS
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum JobType {
  PRODUCT_SYNC
  BLOG_GENERATION
  SITEMAP_BUILD
  KEYWORD_DISCOVERY
  STORE_METADATA
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  storeId         String?
  status          JobStatus @default(PENDING)
  priority        Int       @default(0)
  attempts        Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  payload         Json?     @db.JsonB
  result          Json?     @db.JsonB
  error           String?
  dedupeKey       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogs Blog[]

  @@unique([type, storeId, dedupeKey])
  @@index([type, status, priority, scheduledAt])
  @@index([storeId, type, status])
  @@map("jobs")
}

model Product {
  id                    String        @id @default(uuid()) @db.Uuid
  storeId               String
  shopifyId             String
  handle                String?       @db.Citext
  title                 String
  status                ProductStatus
  description           String?
  tags                  String[]      @default([])
  category              String?
  imageUrl              String?
  onlineStoreUrl        String?
  onlineStorePreviewUrl String
  syncedAt              DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogs Blog[] @relation("BlogProduct")

  @@unique([storeId, handle])
  @@unique([storeId, shopifyId])
  @@index([storeId, status])
  @@map("products")
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storesOwned Store[] @relation("StoreOwner")

  @@map("profiles")
}

model Store {
  id               String      @id @default(cuid())
  ownerId          String      @db.Uuid
  stripeCustomerId String?
  name             String
  domainUrl        String
  profileUrl       String?
  description      String?
  status           StoreStatus @default(LOCKED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  owner    Profile   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blogs    Blog[]
  jobs     Job[]
  products Product[]
  channel  Channel?

  @@index([ownerId])
  @@map("stores")
}

model Channel {
  id        String   @id @default(uuid()) @db.Uuid
  shop      String   @unique @db.Citext
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("channels")
}

model Blog {
  id                    String        @id @default(uuid()) @db.Uuid
  topic                 String?
  title                 String?
  slug                  String?
  description           String?
  brandVoice            String?
  primaryKeyword        String?
  secondaryKeywords     String[]      @default([])
  additionalInstruction String?
  status                BlogStatus    @default(DRAFT)
  currentStep           BlogSetupStep @default(TOPIC)
  storeId               String
  shopifyArticleId      String?
  jobId                 String?       @db.Uuid
  productId             String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product   Product?   @relation("BlogProduct", fields: [productId], references: [id], onDelete: SetNull)
  nodes     Node[]
  thumbnail Thumbnail?

  @@index([storeId])
  @@index([productId])
  @@map("blogs")
}

model Node {
  blogId    String   @db.Uuid
  key       String   @default(cuid())
  parentKey String?
  type      NodeType
  sortOrder Int
  payload   Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent   Node?  @relation("NodeChildren", fields: [blogId, parentKey], references: [blogId, key], onDelete: Cascade)
  children Node[] @relation("NodeChildren")

  @@id([blogId, key])
  @@index([blogId, parentKey, sortOrder])
  @@map("nodes")
}

model Thumbnail {
  id       String @id @default(uuid()) @db.Uuid
  blogId   String @unique @db.Uuid
  altText  String
  blobPath String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}
