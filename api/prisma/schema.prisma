generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum DomainType {
  CORPORATE
  REFERENCE
  INSTITUTIONAL
  EDITORIAL
  UGC
  OTHER
}

enum JobType {
  SITE_AUDIT
  BUSINESS_INITIALIZATION
  PROMPT_RESEARCH
  PROMPT_GENERATION
  MONITORING
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum PlanName {
  STARTER
  PRO
  GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALLING
}

enum BusinessMembershipRole {
  OWNER
  MEMBER
}

enum BusinessInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessSetupStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BusinessSetupStep {
  DOMAIN
  PROFILE
  LOCATION
  COMPETITORS
  ATTRIBUTION
  TOPICS
  PROMPTS
  COMPLETED
}

enum BusinessStatus {
  LOCKED
  PROCESSING
  ACTIVE
  FAILED
}

enum PromptStatus {
  ACTIVE
  INACTIVE
}

enum AiEngine {
  CLAUDE
  CHATGPT
  PERPLEXITY
  AI_OVERVIEWS
}

enum PromptRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PromptResponseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PromptAwarenessStage {
  EXPLORE
  EVALUATE
  DECIDE
}

// --- BILLING MODELS ---

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  name          PlanName
  stripePriceId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  status SubscriptionStatus @default(ACTIVE)

  stripeSubscriptionId String? @unique

  trialEndsAt DateTime?
  businessId  String    @unique

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- CORE MODELS ---

model Business {
  id               String              @id @default(cuid())
  ownerId          String              @db.Uuid
  stripeCustomerId String?
  name             String
  domain           String
  profileUrl       String?
  category         String?
  description      String?
  icp              String?
  location         String?
  timezone         String?
  industry         String?
  distributionChannels String[]     @default([])
  selectedTopicIds     String[]     @default([])
  searchIntentCommercial    Int     @default(70)
  searchIntentInformational Int     @default(30)
  status           BusinessStatus      @default(LOCKED)
  setupStatus      BusinessSetupStatus @default(NOT_STARTED)
  setupStep        BusinessSetupStep   @default(DOMAIN)
  setupCompletedAt DateTime?
  monitoringEnabled Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscription Subscription?

  owner       Profile          @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  competitors Competitor[]
  jobs        Job[]
  prompts     Prompt[]
  tags        Tag[]
  members     BusinessMember[]
  invites     BusinessInvite[]
  metrics     BusinessMetric[]

  @@index([ownerId])
  @@map("businesses")
}

model Competitor {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  domain     String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mentions        Mention[]
  promptMetrics   PromptMetric[]
  businessMetrics BusinessMetric[]

  @@unique([businessId, domain])
  @@index([businessId])
  @@map("competitors")
}

model Profile {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique @db.Citext
  heardAboutUs           String?
  heardAboutUsCapturedAt DateTime?
  lastAccessedBusinessId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  businessesOwned Business[]       @relation("BusinessOwner")
  memberships     BusinessMember[]
  sentInvites     BusinessInvite[] @relation("BusinessInviteSentBy")
  acceptedInvites BusinessInvite[] @relation("BusinessInviteAcceptedBy")

  @@map("profiles")
}

model BusinessMember {
  id         String                 @id @default(uuid()) @db.Uuid
  businessId String
  profileId  String                 @db.Uuid
  role       BusinessMembershipRole @default(MEMBER)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([businessId, profileId])
  @@index([profileId])
  @@map("business_members")
}

model BusinessInvite {
  id           String                 @id @default(uuid()) @db.Uuid
  businessId   String
  email        String                 @db.Citext
  role         BusinessMembershipRole @default(MEMBER)
  status       BusinessInviteStatus   @default(PENDING)
  invitedById  String                 @db.Uuid
  acceptedById String?                @db.Uuid
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  Profile  @relation("BusinessInviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy Profile? @relation("BusinessInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([businessId, email])
  @@index([email, status, expiresAt])
  @@index([invitedById])
  @@map("business_invites")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  businessId      String
  status          JobStatus @default(PENDING)
  priority        Int       @default(0)
  attempts        Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  payload         Json?     @db.JsonB
  result          Json?     @db.JsonB
  progress        Json?     @db.JsonB
  error           String?
  dedupeKey       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audits   Audit[]

  @@unique([type, businessId, dedupeKey])
  @@index([type, status, priority, scheduledAt])
  @@index([businessId, type, status])
  @@map("jobs")
}

model Prompt {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String
  text           String
  status         PromptStatus
  awarenessStage PromptAwarenessStage
  lastRunAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tags      Tag[]
  runs      PromptRun[]
  responses PromptResponse[]
  metrics   PromptMetric[]

  @@unique([businessId, text])
  @@index([businessId])
  @@map("prompts")
}

model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  text       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  prompts  Prompt[]

  @@unique([businessId, text])
  @@map("tags")
}

model PromptRun {
  id          String          @id @default(uuid()) @db.Uuid
  promptId    String          @db.Uuid
  status      PromptRunStatus
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  prompt    Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  responses PromptResponse[]

  @@map("prompt_runs")
}

model PromptResponse {
  id          String               @id @default(uuid()) @db.Uuid
  promptRunId String               @db.Uuid
  promptId    String               @db.Uuid
  engine      AiEngine
  text        String?
  status      PromptResponseStatus
  error       String?
  createdAt   DateTime             @default(now())

  promptRun     PromptRun     @relation(fields: [promptRunId], references: [id], onDelete: Cascade)
  prompt        Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  mentions      Mention[]
  citations     Citation[]
  fanOutQueries FanOutQuery[]

  @@unique([promptRunId, engine])
  @@index([promptId])
  @@map("prompt_responses")
}

model Mention {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  name             String
  domain           String
  position         Int
  competitorId     String?  @db.Uuid
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)
  competitor     Competitor?    @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@map("mentions")
}

model Citation {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  url              String
  domain           String
  title            String?
  position         Int
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)

  @@map("citations")
}

model FanOutQuery {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  query            String
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)

  @@map("fan_out_queries")
}

model PromptMetric {
  id            String   @id @default(uuid()) @db.Uuid
  promptId      String   @db.Uuid
  competitorId  String?  @db.Uuid
  date          DateTime @db.Date
  mentionRate   Float
  citationShare Float
  sov           Float
  createdAt     DateTime @default(now())

  prompt     Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@unique([promptId, competitorId, date])
  @@map("prompt_metrics")
}

model BusinessMetric {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String
  competitorId  String?   @db.Uuid
  engine        AiEngine?
  date          DateTime  @db.Date
  mentionRate   Float
  citationShare Float
  sov           Float
  createdAt     DateTime  @default(now())

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@index([businessId, competitorId, date, engine])
  @@map("business_metrics")
}

// --- AUDIT MODELS ---

model Audit {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.Citext
  domain    String
  country   String   @default("US")
  brandName String?
  jobId     String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Report data (JSON blobs, populated by build-report node)
  visibilityLeaderboard Json? // MentionedBrand[]  — top 6 (+target if outside top 6)
  citationLeaderboard   Json? // CitedDomain[]     — top 6 (+target if outside top 6)
  sentiment             Json? // SentimentResult   — { positivePercent, negativePercent, claims[], responses[] }
  topPages              Json? // CitedPage[]       — top 3
  contentSuggestions    Json? // ContentIdea[]     — 4 items
  brandVisibility       Json? // BrandVisibility   — { google_aio, chatgpt, perplexity, overall } mention rates for target brand

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("audits")
}

// --- DOMAIN INFO MODELS ---

model DomainInfo {
  domain    String     @id
  type      DomainType @default(OTHER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("domain_info")
}
