generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoreStatus {
  DRAFT
  ACTIVE
  LOCKED
  INITIALIZING
  FAILED
}

enum KeywordType {
  BUSINESS
  BLOG
}

enum KeywordIntent {
  COMMERCIAL
  INFORMATIONAL
  NAVIGATIONAL
  TRANSACTIONAL
}

enum BlogGenerationStatus {
  QUEUED
  IN_PROGRESS
  READY
  ERROR
}

enum BlogPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogType {
  LISTICLE
  HOW_TO
}

enum NodeType {
  PARAGRAPH
  HEADING
  LIST
  LIST_ITEM
  CODE_BLOCK
  QUOTE
  IMAGE
  LINK
  TEXT
}

enum GenerationStep {
  TOPIC
  KEYWORD
  COMPETITORS
  TITLE
  SECONDARY_KEYWORDS
  META
  REVIEW
  COMPLETE
}

enum ShopifyProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum JobType {
  PRODUCT_SYNC
  BLOG_GENERATION
  SITEMAP_BUILD
  KEYWORD_DISCOVERY
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        JobType
  storeId     String?
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  attempts    Int       @default(0)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  payload     Json?     @db.JsonB
  result      Json?     @db.JsonB
  error       String?
  dedupeKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([type, status, priority, scheduledAt])
  @@index([storeId, type, status])
  @@unique([type, storeId, dedupeKey])
  @@map("jobs")
}

model Product {
  id               String                @id
  storeId          String
  handle           String                @db.Citext
  title            String
  status           ShopifyProductStatus
  description      String?
  tags             String[]              @default([])
  mainImageUrl     String?
  mainImageAlt     String?
  updatedAtShopify DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  store            Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, handle])
  @@index([storeId, status])
  @@map("products")
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  firstName  String?
  lastName   String?
  profileUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  storesOwned Store[] @relation("StoreOwner")

  @@map("profiles")
}

