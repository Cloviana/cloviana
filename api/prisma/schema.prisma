generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoreStatus {
  DRAFT
  ACTIVE
  LOCKED
  INITIALIZING
  FAILED
}

enum KeywordType {
  BUSINESS
  BLOG
}

enum KeywordIntent {
  I // Informational
  N // Navigational
  C // Commercial
  L // Transactional
}

enum BlogGenerationStatus {
  QUEUED
  IN_PROGRESS
  READY
  ERROR
}

enum BlogPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogType {
  LISTICLE
  HOW_TO
}

enum NodeType {
  PARAGRAPH
  HEADING
  LIST
  LIST_ITEM
  CODE_BLOCK
  QUOTE
  IMAGE
  LINK
  TEXT
}

enum GenerationStep {
  TOPIC
  KEYWORD
  COMPETITORS
  TITLE
  SECONDARY_KEYWORDS
  META
  REVIEW
  COMPLETE
}

enum ShopifyProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum JobType {
  PRODUCT_SYNC
  BLOG_GENERATION
  SITEMAP_BUILD
  KEYWORD_DISCOVERY
  STORE_METADATA
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  storeId         String?
  status          JobStatus @default(PENDING)
  priority        Int       @default(0)
  attempts        Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  payload         Json?     @db.JsonB
  result          Json?     @db.JsonB
  error           String?
  dedupeKey       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogs Blog[]

  @@unique([type, storeId, dedupeKey])
  @@index([type, status, priority, scheduledAt])
  @@index([storeId, type, status])
  @@map("jobs")
}

model Product {
  storeId               String
  shopifyId             String
  handle                String?              @db.Citext
  title                 String
  status                ShopifyProductStatus
  description           String?
  tags                  String[]             @default([])
  category              String?
  imageUrl              String?
  onlineStoreUrl        String?
  onlineStorePreviewUrl String
  syncedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, shopifyId])
  @@unique([storeId, handle])
  @@index([storeId, status])
  @@map("products")
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storesOwned Store[] @relation("StoreOwner")

  @@map("profiles")
}

model Store {
  id               String      @id @default(cuid())
  ownerId          String      @db.Uuid
  stripeCustomerId String?
  name             String
  domainUrl        String
  profileUrl       String?
  description      String?
  status           StoreStatus @default(LOCKED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  owner    Profile        @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  keywords StoreKeyword[]
  blogs    Blog[]
  jobs     Job[]
  products Product[]
  channel  Channel?

  @@index([ownerId])
  @@map("stores")
}

model Channel {
  id        String   @id @default(uuid()) @db.Uuid
  shop      String   @unique @db.Citext
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("channels")
}

model Keyword {
  id           String          @id @default(uuid()) @db.Uuid
  phrase       String          @unique
  volume       Int
  cpc          Int
  intents      KeywordIntent[] @default([])
  historyTrend Json?           @db.JsonB
  difficulty   Int
  competition  Float
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  storeKeywords StoreKeyword[]
  blogs         Blog[]

  @@map("keywords")
}

model StoreKeyword {
  storeId   String
  keywordId String @db.Uuid

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([storeId, keywordId])
  @@map("stores_keywords")
}

model Blog {
  id               String               @id @default(uuid()) @db.Uuid
  topic            String?
  title            String?
  slug             String?
  description      String?
  brandVoice       String?
  keywordId        String?              @db.Uuid
  generationStep   GenerationStep?
  generationStatus BlogGenerationStatus @default(QUEUED)
  publishStatus    BlogPublishStatus    @default(DRAFT)
  storeId          String
  shopifyArticleId String?
  jobId            String?              @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  keyword   Keyword?   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nodes     Node[]
  thumbnail Thumbnail?

  @@index([storeId])
  @@map("blogs")
}

model Node {
  blogId    String   @db.Uuid
  key       String   @default(cuid())
  parentKey String?
  type      NodeType
  sortOrder Int
  payload   Json     @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent   Node?  @relation("NodeChildren", fields: [blogId, parentKey], references: [blogId, key], onDelete: Cascade)
  children Node[] @relation("NodeChildren")

  @@id([blogId, key])
  @@index([blogId, parentKey, sortOrder])
  @@map("nodes")
}

model Thumbnail {
  id       String @id @default(uuid()) @db.Uuid
  blogId   String @unique @db.Uuid
  altText  String
  blobPath String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("thumbnails")
}
