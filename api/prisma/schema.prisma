generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum JobType {
  SITE_AUDIT
  BUSINESS_INITIALIZATION
  PROMPT_RESEARCH
  PROMPT_GENERATION
  MONITORING
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum PlanName {
  STARTER
  PRO
  GROWTH
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALLING
}

enum BusinessMembershipRole {
  OWNER
  MEMBER
}

enum BusinessInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessSetupStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BusinessSetupStep {
  DOMAIN
  PROFILE
  LOCATION
  COMPETITORS
  ATTRIBUTION
  TOPICS
  PROMPTS
  COMPLETED
}

enum BusinessStatus {
  LOCKED
  PROCESSING
  ACTIVE
  FAILED
}

enum PromptStatus {
  ACTIVE
  INACTIVE
}

enum AiEngine {
  CLAUDE
  CHATGPT
  PERPLEXITY
  AI_OVERVIEWS
}

enum PromptRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PromptResponseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PromptAwarenessStage {
  AWARENESS
  EXPLORE
  CONSIDERATION
  EVALUATE
  DECIDE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
}

// --- BILLING MODELS ---

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  name          PlanName
  stripePriceId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  status SubscriptionStatus @default(ACTIVE)

  stripeSubscriptionId String? @unique

  trialEndsAt DateTime?
  businessId  String    @unique

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- CORE MODELS ---

model Business {
  id                        String              @id @default(cuid())
  ownerId                   String              @db.Uuid
  stripeCustomerId          String?
  name                      String
  domain                    String
  category                  String
  description               String
  personas                  String[]  @default([])
  status                    BusinessStatus      @default(LOCKED)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?

  owner          Profile          @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  competitors    Competitor[]
  jobs           Job[]
  prompts        Prompt[]
  tags           Tag[]
  members        BusinessMember[]
  invites        BusinessInvite[]
  metrics        BusinessMetric[]
  folders        Folder[]
  documents      Document[]
  chats          Chat[]

  @@index([ownerId])
  @@map("businesses")
}

enum ChatMessageRole {
  user
  assistant
}

model Chat {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([businessId, updatedAt])
  @@map("chats")
}

model ChatMessage {
  id        String          @id @default(uuid()) @db.Uuid
  chatId    String          @db.Uuid
  role      ChatMessageRole
  content   Json            @db.JsonB
  createdAt DateTime        @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}

model Competitor {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  domain     String
  name       String
  aliases    String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mentions        Mention[]
  promptMetrics   PromptMetric[]
  businessMetrics BusinessMetric[]

  @@unique([businessId, domain])
  @@index([businessId])
  @@map("competitors")
}

model Profile {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique @db.Citext
  heardAboutUs           String?
  heardAboutUsCapturedAt DateTime?
  lastAccessedBusinessId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  businessesOwned Business[]       @relation("BusinessOwner")
  memberships     BusinessMember[]
  sentInvites     BusinessInvite[] @relation("BusinessInviteSentBy")
  acceptedInvites BusinessInvite[] @relation("BusinessInviteAcceptedBy")

  @@map("profiles")
}

model BusinessMember {
  id         String                 @id @default(uuid()) @db.Uuid
  businessId String
  profileId  String                 @db.Uuid
  role       BusinessMembershipRole @default(MEMBER)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([businessId, profileId])
  @@index([profileId])
  @@map("business_members")
}

model BusinessInvite {
  id           String                 @id @default(uuid()) @db.Uuid
  businessId   String
  email        String                 @db.Citext
  role         BusinessMembershipRole @default(MEMBER)
  status       BusinessInviteStatus   @default(PENDING)
  invitedById  String                 @db.Uuid
  acceptedById String?                @db.Uuid
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  Profile  @relation("BusinessInviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy Profile? @relation("BusinessInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([businessId, email])
  @@index([email, status, expiresAt])
  @@index([invitedById])
  @@map("business_invites")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  businessId      String
  status          JobStatus @default(PENDING)
  priority        Int       @default(0)
  progress        Json?     @db.JsonB
  attempts        Int       @default(0)
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  payload         Json?     @db.JsonB
  result          Json?     @db.JsonB
  error           String?
  dedupeKey       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audits   Audit[]

  @@unique([type, businessId, dedupeKey])
  @@index([type, status, priority, scheduledAt])
  @@index([businessId, type, status])
  @@map("jobs")
}

model Prompt {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String
  text           String
  status         PromptStatus
  awarenessStage PromptAwarenessStage
  lastRunAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tags      Tag[]
  runs      PromptRun[]
  responses PromptResponse[]
  metrics   PromptMetric[]

  @@unique([businessId, text])
  @@index([businessId])
  @@map("prompts")
}

model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  text       String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  prompts  Prompt[]

  @@unique([businessId, text])
  @@map("tags")
}

model PromptRun {
  id          String          @id @default(uuid()) @db.Uuid
  promptId    String          @db.Uuid
  status      PromptRunStatus
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  prompt    Prompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  responses PromptResponse[]

  @@map("prompt_runs")
}

model PromptResponse {
  id          String               @id @default(uuid()) @db.Uuid
  promptRunId String               @db.Uuid
  promptId    String               @db.Uuid
  engine      AiEngine
  text        String?
  status      PromptResponseStatus
  error       String?
  createdAt   DateTime             @default(now())

  promptRun     PromptRun     @relation(fields: [promptRunId], references: [id], onDelete: Cascade)
  prompt        Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  mentions      Mention[]
  citations     Citation[]
  fanOutQueries FanOutQuery[]

  @@unique([promptRunId, engine])
  @@index([promptId])
  @@map("prompt_responses")
}

model Mention {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  name             String
  domain           String
  position         Int
  competitorId     String?  @db.Uuid
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)
  competitor     Competitor?    @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@map("mentions")
}

model Citation {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  url              String
  domain           String
  title            String?
  position         Int
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)

  @@map("citations")
}

model FanOutQuery {
  id               String   @id @default(uuid()) @db.Uuid
  promptResponseId String   @db.Uuid
  query            String
  inferred         Boolean  @default(false)
  createdAt        DateTime @default(now())

  promptResponse PromptResponse @relation(fields: [promptResponseId], references: [id], onDelete: Cascade)

  @@map("fan_out_queries")
}

model PromptMetric {
  id            String   @id @default(uuid()) @db.Uuid
  promptId      String   @db.Uuid
  competitorId  String?  @db.Uuid
  date          DateTime @db.Date
  mentionRate   Float
  citationShare Float
  sov           Float
  createdAt     DateTime @default(now())

  prompt     Prompt      @relation(fields: [promptId], references: [id], onDelete: Cascade)
  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([promptId, competitorId, date])
  @@index([competitorId])
  @@map("prompt_metrics")
}

model BusinessMetric {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String
  competitorId  String?   @db.Uuid
  engine        AiEngine?
  date          DateTime  @db.Date
  mentionRate   Float
  citationShare Float
  sov           Float
  createdAt     DateTime  @default(now())

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([businessId, competitorId, date, engine])
  @@index([competitorId])
  @@map("business_metrics")
}

model Folder {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String
  parentId   String?  @db.Uuid
  name       String   @db.Citext
  position   Int      @default(0)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderHierarchy", fields: [parentId, businessId], references: [id, businessId], onDelete: Restrict)
  children  Folder[]   @relation("FolderHierarchy")
  documents Document[]

  @@unique([id, businessId])
  @@unique([businessId, parentId, name])
  @@index([businessId, parentId, position])
  @@map("folders")
}

model Document {
  id                 String         @id @default(uuid()) @db.Uuid
  businessId         String
  folderId           String         @db.Uuid
  name               String
  extension          String
  filename           String?
  mimeType           String?
  sizeBytes           Int            @default(0)
  position            Int            @default(0)
  filePath           String?
  status             DocumentStatus @default(PENDING)
  chunkCount         Int?
  ingestionQueuedAt  DateTime?
  ingestionStartedAt DateTime?
  deletedAt          DateTime?
  indexedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  folder   Folder   @relation(fields: [folderId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, status])
  @@index([businessId, folderId, position])
  @@index([status, ingestionQueuedAt, createdAt])
  @@index([status, ingestionStartedAt])
  @@index([deletedAt, createdAt])
  @@map("documents")
}

// --- AUDIT MODELS ---

model Audit {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  email     String   @db.Citext
  domain    String
  country   String   @default("US")
  brandName String?
  jobId     String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Report data (JSON blobs, populated by build-report node)
  visibilityLeaderboard Json? // MentionedBrand[]  — top 6 (+target if outside top 6)
  citationLeaderboard   Json? // CitedDomain[]     — top 6 (+target if outside top 6)
  sentiment             Json? // SentimentResult   — { positivePercent, negativePercent, claims[], responses[] }
  topPages              Json? // CitedPage[]       — top 3
  contentSuggestions    Json? // ContentIdea[]     — 4 items
  brandVisibility       Json? // BrandVisibility   — { google_aio, chatgpt, perplexity, overall } mention rates for target brand
  promptCoverage        Json? // AuditPromptCoverage[] — per-prompt mention and citation rates

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("audits")
}
