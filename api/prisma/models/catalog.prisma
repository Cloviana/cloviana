enum ProductStatus {
  DRAFT
  PROPOSED
  PUBLISHED
  REJECTED
  UNLISTED
  ARCHIVED
}

enum AttributeType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  UNIT
  TOGGLE
}

enum ProductChangeStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELED
}

enum ProductChangeActionType {
  UPDATE
  STATUS_CHANGE
  VARIANT_ADD
  VARIANT_UPDATE
  VARIANT_REMOVE
  ATTRIBUTE_ADD
  ATTRIBUTE_UPDATE
  ATTRIBUTE_REMOVE
  PRODUCT_ADD
  PRODUCT_DELETE
  CHANGE_REQUESTED
}

// -----------------------------------------------------------------------------
// Catalog: the shared master catalog
// -----------------------------------------------------------------------------
model ProductType {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  value         String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, value])
  @@map("product_types")
}

model ProductCollection {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  title         String
  handle        String   @db.Citext
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  marketplace  Marketplace             @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  productLinks ProductCollectionLink[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, handle])
  @@map("product_collections")
}

model ProductCategory {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  parentId      String?  @db.Uuid
  name          String
  handle        String   @db.Citext
  description   String?
  isActive      Boolean  @default(true)
  isInternal    Boolean  @default(false)
  rank          Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  marketplace  Marketplace           @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  parent       ProductCategory?      @relation("CategoryTree", fields: [marketplaceId, parentId], references: [marketplaceId, id], onDelete: Restrict)
  children     ProductCategory[]     @relation("CategoryTree")
  productLinks ProductCategoryLink[]
  sellerLinks  CategorySeller[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, handle])
  @@index([marketplaceId, parentId])
  @@map("product_categories")
}

model ProductTag {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  value         String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  marketplace  Marketplace      @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  productLinks ProductTagLink[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, value])
  @@map("product_tags")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  marketplaceId  String        @db.Uuid
  typeId         String?       @db.Uuid
  title          String
  handle         String        @db.Citext
  subtitle       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  status         ProductStatus @default(DRAFT)
  thumbnail      String?
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  marketplace      Marketplace             @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  type             ProductType?            @relation(fields: [marketplaceId, typeId], references: [marketplaceId, id], onDelete: Restrict)
  collectionLinks  ProductCollectionLink[]
  images           ProductImage[]
  variants         ProductVariant[]
  categoryLinks    ProductCategoryLink[]
  tagLinks         ProductTagLink[]
  sellerLinks      ProductSeller[]
  offers           Offer[]
  attributes       ProductAttribute[]
  attributeEntries ProductAttributeEntry[]
  changes          ProductChange[]
  changeActions    ProductChangeAction[]
  reviews          Review[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, handle])
  @@index([marketplaceId, status])
  @@map("products")
}

model ProductImage {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  productId     String   @db.Uuid
  mediaAssetId  String   @db.Uuid
  url           String
  rank          Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  product    Product    @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [marketplaceId, mediaAssetId], references: [marketplaceId, id], onDelete: Restrict)

  @@index([marketplaceId, mediaAssetId])
  @@index([marketplaceId, productId])
  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  productId     String   @db.Uuid
  title         String
  customTitle   String?
  sku           String?
  isActive      Boolean  @default(true)
  barcode       String?
  rank          Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  product         Product                 @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  offers          Offer[]
  attributeValues VariantAttributeValue[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, sku])
  @@unique([marketplaceId, productId, id])
  @@map("product_variants")
}

// Which sellers may sell a product (allowlist).
model ProductSeller {
  marketplaceId String   @db.Uuid
  productId     String   @db.Uuid
  sellerId      String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  seller  Seller  @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Cascade)

  @@id([marketplaceId, productId, sellerId])
  @@index([marketplaceId, sellerId])
  @@map("product_sellers")
}

// Which sellers may list in a category (allowlist).
model CategorySeller {
  marketplaceId String   @db.Uuid
  categoryId    String   @db.Uuid
  sellerId      String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  category ProductCategory @relation(fields: [marketplaceId, categoryId], references: [marketplaceId, id], onDelete: Cascade)
  seller   Seller          @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Cascade)

  @@id([marketplaceId, categoryId, sellerId])
  @@index([marketplaceId, sellerId])
  @@map("category_sellers")
}

model ProductCollectionLink {
  marketplaceId String @db.Uuid
  productId     String @db.Uuid
  collectionId  String @db.Uuid

  product    Product           @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  collection ProductCollection @relation(fields: [marketplaceId, collectionId], references: [marketplaceId, id], onDelete: Cascade)

  @@id([marketplaceId, productId, collectionId])
  @@index([marketplaceId, collectionId])
  @@map("product_collection_links")
}

model ProductCategoryLink {
  marketplaceId String @db.Uuid
  productId     String @db.Uuid
  categoryId    String @db.Uuid

  product  Product         @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  category ProductCategory @relation(fields: [marketplaceId, categoryId], references: [marketplaceId, id], onDelete: Cascade)

  @@id([marketplaceId, productId, categoryId])
  @@index([marketplaceId, categoryId])
  @@map("product_category_links")
}

model ProductTagLink {
  marketplaceId String @db.Uuid
  productId     String @db.Uuid
  tagId         String @db.Uuid

  product Product    @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [marketplaceId, tagId], references: [marketplaceId, id], onDelete: Cascade)

  @@id([marketplaceId, productId, tagId])
  @@index([marketplaceId, tagId])
  @@map("product_tag_links")
}

// -----------------------------------------------------------------------------
// Attributes. Variant-axis attributes replace Medusa's separate option tables.
// -----------------------------------------------------------------------------
model ProductAttribute {
  id            String        @id @default(uuid()) @db.Uuid
  marketplaceId String        @db.Uuid
  productId     String?       @db.Uuid // null = global attribute, set = scoped to one product
  name          String
  handle        String?       @db.Citext
  description   String?
  type          AttributeType
  isRequired    Boolean       @default(false)
  isFilterable  Boolean       @default(false)
  isVariantAxis Boolean       @default(false)
  rank          Int           @default(0)
  isActive      Boolean       @default(true)
  createdBy     String?       @db.Uuid
  metadata      Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  marketplace Marketplace             @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  product     Product?                @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  values      ProductAttributeValue[]
  entries     ProductAttributeEntry[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, handle])
  @@index([marketplaceId, productId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  attributeId   String   @db.Uuid
  name          String
  handle        String?  @db.Citext
  rank          Int      @default(0)
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  attribute     ProductAttribute        @relation(fields: [marketplaceId, attributeId], references: [marketplaceId, id], onDelete: Cascade)
  entries       ProductAttributeEntry[]
  variantValues VariantAttributeValue[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, attributeId, handle])
  @@map("product_attribute_values")
}

// A product's value for an attribute: a chosen value (select types) or free text/unit/toggle.
model ProductAttributeEntry {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  productId     String   @db.Uuid
  attributeId   String   @db.Uuid
  valueId       String?  @db.Uuid
  textValue     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  product   Product                @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  attribute ProductAttribute       @relation(fields: [marketplaceId, attributeId], references: [marketplaceId, id], onDelete: Restrict)
  value     ProductAttributeValue? @relation(fields: [marketplaceId, valueId], references: [marketplaceId, id], onDelete: Restrict)

  @@unique([marketplaceId, productId, attributeId, valueId])
  @@index([marketplaceId, productId])
  @@map("product_attribute_entries")
}

model VariantAttributeValue {
  marketplaceId    String @db.Uuid
  variantId        String @db.Uuid
  attributeValueId String @db.Uuid

  variant        ProductVariant        @relation(fields: [marketplaceId, variantId], references: [marketplaceId, id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [marketplaceId, attributeValueId], references: [marketplaceId, id], onDelete: Restrict)

  @@id([marketplaceId, variantId, attributeValueId])
  @@index([marketplaceId, attributeValueId])
  @@map("variant_attribute_values")
}

// -----------------------------------------------------------------------------
// Offers: a seller's listing against the master catalog
// -----------------------------------------------------------------------------
model ShippingProfile {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  sellerId      String   @db.Uuid
  name          String
  type          String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  seller Seller  @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Restrict)
  offers Offer[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, sellerId])
  @@map("shipping_profiles")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  marketplaceId    String   @db.Uuid
  sellerId         String   @db.Uuid
  sku              String?
  stockedQuantity  Int      @default(0)
  reservedQuantity Int      @default(0)
  requiresShipping Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  seller     Seller               @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Restrict)
  offerLinks OfferInventoryItem[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, sellerId])
  @@map("inventory_items")
}

model Offer {
  id                String    @id @default(uuid()) @db.Uuid
  marketplaceId     String    @db.Uuid
  sellerId          String    @db.Uuid
  productId         String    @db.Uuid
  variantId         String    @db.Uuid
  shippingProfileId String?   @db.Uuid
  sku               String
  ean               String?
  upc               String?
  createdBy         String?   @db.Uuid
  metadata          Json?
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  seller          Seller               @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Restrict)
  product         Product              @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Restrict)
  variant         ProductVariant       @relation(fields: [marketplaceId, productId, variantId], references: [marketplaceId, productId, id], onDelete: Restrict)
  shippingProfile ShippingProfile?     @relation(fields: [marketplaceId, shippingProfileId], references: [marketplaceId, id], onDelete: Restrict)
  prices          OfferPrice[]
  inventoryItems  OfferInventoryItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, sellerId, sku])
  @@index([marketplaceId, productId])
  @@index([marketplaceId, variantId])
  @@map("offers")
}

model OfferPrice {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  offerId       String   @db.Uuid
  currencyCode  String   @db.Char(3)
  amount        BigInt
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  offer Offer @relation(fields: [marketplaceId, offerId], references: [marketplaceId, id], onDelete: Cascade)

  @@unique([marketplaceId, offerId, currencyCode])
  @@map("offer_prices")
}

model OfferInventoryItem {
  marketplaceId    String @db.Uuid
  offerId          String @db.Uuid
  inventoryItemId  String @db.Uuid
  requiredQuantity Int    @default(1)

  offer         Offer         @relation(fields: [marketplaceId, offerId], references: [marketplaceId, id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [marketplaceId, inventoryItemId], references: [marketplaceId, id], onDelete: Restrict)

  @@id([marketplaceId, offerId, inventoryItemId])
  @@index([marketplaceId, inventoryItemId])
  @@map("offer_inventory_items")
}

// -----------------------------------------------------------------------------
// Product edit: reviewable change pipeline for seller edits
// -----------------------------------------------------------------------------
model ProductChange {
  id                   String              @id @default(uuid()) @db.Uuid
  marketplaceId        String              @db.Uuid
  productId            String              @db.Uuid
  status               ProductChangeStatus @default(PENDING)
  internalNote         String?
  externalNote         String?
  createdBy            String?             @db.Uuid
  confirmedBy          String?             @db.Uuid
  confirmedAt          DateTime?           @db.Timestamptz(3)
  declinedBy           String?             @db.Uuid
  declinedAt           DateTime?           @db.Timestamptz(3)
  declinedReason       String?
  canceledBy           String?             @db.Uuid
  canceledAt           DateTime?           @db.Timestamptz(3)
  requiresActionBy     String?             @db.Uuid
  requiresActionAt     DateTime?           @db.Timestamptz(3)
  requiresActionReason String?
  metadata             Json?
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  product Product               @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  actions ProductChangeAction[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, productId, status])
  @@map("product_changes")
}

// productChangeId is optional (an action can exist before it is attached). Mercur sets it to
// null when a change is deleted; here the application detaches actions before deleting a change.
model ProductChangeAction {
  id              String                  @id @default(uuid()) @db.Uuid
  marketplaceId   String                  @db.Uuid
  productId       String                  @db.Uuid
  productChangeId String?                 @db.Uuid
  ordering        Int                     @default(autoincrement())
  action          ProductChangeActionType
  details         Json                    @default("{}")
  internalNote    String?
  applied         Boolean                 @default(false)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  product Product        @relation(fields: [marketplaceId, productId], references: [marketplaceId, id], onDelete: Cascade)
  change  ProductChange? @relation(fields: [marketplaceId, productChangeId], references: [marketplaceId, id], onDelete: Restrict)

  @@index([marketplaceId, productId])
  @@index([marketplaceId, productChangeId, ordering])
  @@map("product_change_actions")
}
