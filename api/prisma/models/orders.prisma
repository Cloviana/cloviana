enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  COMPLETED
  CANCELED
}

model Cart {
  id              String     @id @default(uuid()) @db.Uuid
  marketplaceId   String     @db.Uuid
  customerId      String?    @db.Uuid
  email           String?    @db.Citext
  currencyCode    String     @db.Char(3)
  status          CartStatus @default(ACTIVE)
  shippingAddress Json?
  billingAddress  Json?
  expiresAt       DateTime?  @db.Timestamptz(3)
  completedAt     DateTime?  @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  customer    Customer?   @relation(fields: [marketplaceId, customerId], references: [marketplaceId, id], onDelete: Restrict)
  items       CartItem[]
  orderGroup  OrderGroup?

  @@unique([marketplaceId, id])
  @@index([marketplaceId, customerId])
  @@index([marketplaceId, status])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  cartId        String   @db.Uuid
  offerId       String   @db.Uuid
  quantity      Int
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  cart  Cart  @relation(fields: [marketplaceId, cartId], references: [marketplaceId, id], onDelete: Cascade)
  offer Offer @relation(fields: [marketplaceId, offerId], references: [marketplaceId, id], onDelete: Restrict)

  @@unique([marketplaceId, cartId, offerId])
  @@map("cart_items")
}

// One checkout. Wraps the per-seller orders created when a multi-seller cart is split.
model OrderGroup {
  id            String    @id @default(uuid()) @db.Uuid
  marketplaceId String    @db.Uuid
  displayId     Int
  customerId    String?   @db.Uuid
  cartId        String    @db.Uuid
  currencyCode  String    @db.Char(3)
  sellerCount   Int
  total         BigInt
  metadata      Json?
  deletedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  customer Customer? @relation(fields: [marketplaceId, customerId], references: [marketplaceId, id], onDelete: Restrict)
  cart     Cart      @relation(fields: [marketplaceId, cartId], references: [marketplaceId, id], onDelete: Restrict)
  orders   Order[]
  payments Payment[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, displayId])
  @@unique([marketplaceId, cartId])
  @@index([marketplaceId, customerId])
  @@map("order_groups")
}

// A per-seller order.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  marketplaceId   String      @db.Uuid
  displayId       Int
  orderGroupId    String      @db.Uuid
  sellerId        String      @db.Uuid
  customerId      String?     @db.Uuid
  status          OrderStatus @default(PENDING)
  currencyCode    String      @db.Char(3)
  email           String?     @db.Citext
  subtotal        BigInt
  shippingTotal   BigInt      @default(0)
  taxTotal        BigInt      @default(0)
  total           BigInt
  shippingAddress Json?
  billingAddress  Json?
  canceledAt      DateTime?   @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  orderGroup      OrderGroup            @relation(fields: [marketplaceId, orderGroupId], references: [marketplaceId, id], onDelete: Restrict)
  seller          Seller                @relation(fields: [marketplaceId, sellerId], references: [marketplaceId, id], onDelete: Restrict)
  customer        Customer?             @relation(fields: [marketplaceId, customerId], references: [marketplaceId, id], onDelete: Restrict)
  items           OrderItem[]
  shippingMethods OrderShippingMethod[]
  commissionLines CommissionLine[]
  refunds         Refund[]
  payoutOrder     PayoutOrder?
  reviews         Review[]

  @@unique([marketplaceId, id])
  @@unique([marketplaceId, displayId])
  @@unique([marketplaceId, orderGroupId, sellerId])
  @@index([marketplaceId, sellerId, status])
  @@map("orders")
}

// Title, sku and prices are snapshots taken at checkout.
model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  orderId       String   @db.Uuid
  offerId       String   @db.Uuid
  title         String
  variantTitle  String?
  sku           String
  thumbnail     String?
  quantity      Int
  unitPrice     BigInt
  taxTotal      BigInt   @default(0)
  total         BigInt
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order           Order            @relation(fields: [marketplaceId, orderId], references: [marketplaceId, id], onDelete: Restrict)
  offer           Offer            @relation(fields: [marketplaceId, offerId], references: [marketplaceId, id], onDelete: Restrict)
  commissionLines CommissionLine[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, orderId])
  @@map("order_items")
}

model OrderShippingMethod {
  id            String   @id @default(uuid()) @db.Uuid
  marketplaceId String   @db.Uuid
  orderId       String   @db.Uuid
  name          String
  amount        BigInt
  taxTotal      BigInt   @default(0)
  total         BigInt
  data          Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order           Order            @relation(fields: [marketplaceId, orderId], references: [marketplaceId, id], onDelete: Restrict)
  commissionLines CommissionLine[]

  @@unique([marketplaceId, id])
  @@index([marketplaceId, orderId])
  @@map("order_shipping_methods")
}
