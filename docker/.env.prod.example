# =====================================================================
# Production (docker/.env on the server). deploy-production.yml writes
# this file from GitHub variables/secrets; this is the reference list.
# =====================================================================

# ---------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------
APP_URL=https://admin.cloviana.com
API_URL=https://api.cloviana.com/api
WEB_URL=https://cloviana.com

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
# Server-side API URL for the admin container (compose sets it).
INTERNAL_API_URL=http://api:5000/api

# ---------------------------------------------------------------------
# Platform auth: owners and staff (REQUIRED, 32+ characters)
# ---------------------------------------------------------------------
PLATFORM_AUTH_SECRET=

# ---------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------
# Marketplace realm: stores live at <slug>.PLATFORM_BASE_DOMAIN (REQUIRED)
# ---------------------------------------------------------------------
PLATFORM_BASE_DOMAIN=cloviana.com
MARKETPLACE_AUTH_URL=https://api.cloviana.com
# 32+ characters. Generate with: openssl rand -base64 48
MARKETPLACE_AUTH_SECRET=
MARKETPLACE_AUTH_EMAIL_FROM=Cloviana <no-reply@cloviana.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Self-hosted Inngest (REQUIRED)
# ---------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# URL-safe because it is embedded in a Postgres URI.
INNGEST_POSTGRES_PASSWORD=
INNGEST_MAX_WORKER_CONCURRENCY=12

# ---------------------------------------------------------------------
# Optional providers
# ---------------------------------------------------------------------
RESEND_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Cloudflare R2 product media
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------
# Marketing site analytics
# ---------------------------------------------------------------------
GA4_API_SECRET=

# ---------------------------------------------------------------------
# Cloudflare certificate renewal
# ---------------------------------------------------------------------
CLOUDFLARE_DNS_API_TOKEN=
