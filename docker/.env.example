# =====================================================================
# Docker dev (docker/.env). Copy to docker/.env.
# Dev only needs the optional values below; everything has a default.
# The API itself reads api/.env, not this file.
# =====================================================================

# ---------------------------------------------------------------------
# Self-hosted Inngest (defaults work in dev)
# ---------------------------------------------------------------------
INNGEST_EVENT_KEY=0123456789abcdef0123456789abcdef
INNGEST_SIGNING_KEY=abcdef0123456789abcdef0123456789
# URL-safe because it is embedded in a Postgres URI.
INNGEST_POSTGRES_PASSWORD=inngest
